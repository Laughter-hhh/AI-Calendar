# ===== AI 服务配置（可选）=====
# 不配置 OPENAI_API_KEY 时，应用会自动使用内置的本地解析器，核心闭环仍然可以跑通
OPENAI_API_KEY=

# 默认使用 OpenAI 官方接口；也可以换成任何 OpenAI 兼容服务（模型可替换）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 可选：主模型超时后按序调用备用 OpenAI 兼容服务（Key 仅放服务端）
# AI_PROVIDER_TIMEOUT_MS=6500
# AI_FALLBACK_1_NAME=qwen
# AI_FALLBACK_1_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_FALLBACK_1_MODEL=qwen-plus
# AI_FALLBACK_1_API_KEY=
# AI_FALLBACK_2_NAME=glm
# AI_FALLBACK_2_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_FALLBACK_2_MODEL=glm-5.3
# AI_FALLBACK_2_API_KEY=

# ===== 使用方法 =====
# 复制本文件为 .env.local 并填入你的 Key：
#   copy .env.example .env.local   （PowerShell）
# 注意：.env 文件不会提交到 Git，避免泄露密钥
